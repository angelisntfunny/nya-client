  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "minecraft-mod",
      "components": ["common", "1.20.6-fabric"]
    }
  ],
  "packages": {
    "common": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG-common.md"
